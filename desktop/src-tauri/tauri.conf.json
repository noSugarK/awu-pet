{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YierBubu-Pet",
  "mainBinaryName": "YierBubu-Pet",
  "version": "0.2.0",
  "identifier": "com.nosugark.yierbubupet",
  "build": {
    "frontendDist": "../../docs"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "YierBubu-Pet",
        "url": "pet.html",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Designed by 黄小B · Powered by noSugarK",
    "category": "Entertainment",
    "shortDescription": "YierBubu-Pet · 一二和布布住进你的桌面：会陪你玩，还会帮你“吃掉”文件。",
    "longDescription": "YierBubu-Pet 是一款以一二和布布为主角的桌面宠物。它们站在你的任务栏上，眼睛跟着鼠标转，没人理时自己散步、吃面、喝奶茶、跳舞、抱抱，你离开电脑就趴下睡觉。它们还是会吃文件的回收站：把文件拖到熊身上，或者在资源管理器里右键「请一二删除」，它们就会跑过去张开大嘴吃掉——文件进系统回收站，随时可以找回。Designed by 黄小B · Powered by noSugarK。形象版权归原作者所有，本软件为非商业粉丝作品。"
  }
}
