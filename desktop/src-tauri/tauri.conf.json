{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Awu-Pet",
  "mainBinaryName": "Awu-Pet",
  "version": "0.5.2",
  "identifier": "com.nosugark.yierbubupet",
  "build": {
    "frontendDist": "../../docs"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Awu Pet",
        "url": "pet.html",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Designed by 黄小B · Powered by noSugarK",
    "category": "Entertainment",
    "resources": { "pets/": "pets/" },
    "windows": {
      "nsis": { "installerHooks": "installer-hooks.nsh" },
      "wix": { "language": "zh-CN" }
    },
    "shortDescription": "Awu Pet · 嗷呜桌宠：住在任务栏上的桌宠，会陪你玩，还会帮你“嗷呜”一口吃掉文件。",
    "longDescription": "Awu Pet（嗷呜桌宠）是一款帧动画桌面宠物，默认角色是一二和布布，也可按需下载或导入其他宠物包。它们站在任务栏上，自己散步、玩耍、跳舞、抱抱，离开电脑时会睡觉。把文件拖到它们身上，或者在资源管理器里右键「请一二删除」，文件会移入系统回收站，宠物随机表演吃掉或踢走；小文件直接处理，大文件先确认，之后仍可找回。一二、布布 Designed by 黄小B · Powered by noSugarK。形象版权归原作者所有，本软件为非商业粉丝作品。"
  }
}
